{
  "name": "dsh-workbuddy-manager",
  "version": "0.4.3",
  "description": "将 WorkBuddy 订阅反代到 DeepSeek Harness 使用的 DSH 插件（内置账号池与本地网关）",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fanch-hui/dsh-workbuddy-manager.git"
  },
  "homepage": "https://github.com/Fanch-hui/dsh-workbuddy-manager#readme",
  "bugs": {
    "url": "https://github.com/Fanch-hui/dsh-workbuddy-manager/issues"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "dsh-workbuddy": "./lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "node": "./lib/client.js",
      "default": "./lib/ui-bundle.js"
    },
    "./typert": {
      "types": "./lib/manager/contract.d.ts",
      "default": "./lib/manager/contract.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/build-ui.mjs",
    "test": "npm run build && node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build && npm run check:package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.12",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "dsh-bundle",
    "workbuddy",
    "workbuddy-manager",
    "codebuddy"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "zod": "4.6.7"
  }
}
