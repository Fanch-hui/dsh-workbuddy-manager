{
  "name": "dsh-workbuddy-manager",
  "version": "0.1.0",
  "description": "接入 WorkBuddy Manager 账号池网关的 DeepSeek Harness 插件（DSH 0.2.2-rc.1）",
  "type": "module",
  "license": "MIT",
  "main": "./lib/client.js",
  "types": "./lib/client.d.ts",
  "bin": {
    "dsh-workbuddy": "./lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "test": "npm run build && node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build && npm run check:package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "workbuddy-manager",
    "openai-responses"
  ]
}
